{
  "name": "delta-form",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && npm run test:api && npm run test:scripts",
    "test:api": "node --test \"api/**/*.test.js\"",
    "test:scripts": "node --experimental-test-module-mocks --test \"scripts/**/*.test.mjs\"",
    "check:env": "node scripts/check-dev-env.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm run check:env && drizzle-kit migrate",
    "db:seed": "node scripts/seed-dev.mjs",
    "db:create-admin": "node scripts/create-admin.mjs",
    "dev:api": "node scripts/dev-api.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p db && tsc -p .",
    "lint": "eslint . && npm run lint --workspaces --if-present"
  },
  "dependencies": {
    "@neon/config": "^1.12.0",
    "@neon/env": "^2.0.0",
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.1"
  }
}
