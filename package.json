{
  "name": "delta-form",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && npm run test:api && npm run test:scripts",
    "test:api": "node --test \"api/**/*.test.js\"",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "check:env": "node scripts/check-dev-env.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm run check:env && drizzle-kit migrate",
    "db:seed": "npm run check:env && node scripts/seed-dev.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p db && tsc -p ."
  },
  "dependencies": {
    "@neon/config": "^1.12.0",
    "@neon/env": "^2.0.0",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
